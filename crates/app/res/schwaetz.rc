#include <winres.h>

1 ICON "schwaetz.ico"
1 24 "schwaetz.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     SCHWAETZ_VERSION_BIN
 PRODUCTVERSION  SCHWAETZ_VERSION_BIN
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "schwaetz IRC client"
            VALUE "FileVersion", SCHWAETZ_VERSION_STR
            VALUE "InternalName", "schwaetz"
            VALUE "LegalCopyright", "Copyright (C) 2026 julian. Licensed under the GNU GPL v3."
            VALUE "OriginalFilename", "schwaetz.exe"
            VALUE "ProductName", "schwaetz"
            VALUE "ProductVersion", SCHWAETZ_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
